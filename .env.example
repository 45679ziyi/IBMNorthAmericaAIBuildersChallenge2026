# AURORA Campus Intelligence — Environment Variables
# Copy this file to .env and fill in values. Never commit .env.

# ─── Backend ──────────────────────────────────────────────────────────────────
# Path to the SQLite database file (leave blank to use backend/aurora.db)
DATABASE_URL=sqlite:///./aurora.db

# Demo user ID (UUID) auto-created by seed script
DEMO_USER_ID=00000000-0000-0000-0000-000000000001

# ─── AI Provider (optional) ───────────────────────────────────────────────────
# Supported values: "mock" (default, no external call), "watsonx"
AI_PROVIDER=mock

# IBM watsonx.ai — only used when AI_PROVIDER=watsonx
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# ─── Weather Adapter (optional) ───────────────────────────────────────────────
# Supported values: "sample" (default), "openweathermap"
WEATHER_PROVIDER=sample
OPENWEATHERMAP_API_KEY=
WEATHER_LOCATION=Stony Brook, NY, US

# ─── Frontend (Vite) ──────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
